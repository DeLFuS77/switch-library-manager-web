{
  "openapi": "3.0.3",
  "info": {
    "title": "Switch Library Manager Web API",
    "description": "Read the library, its statistics and download files. When a login is required (users exist, or SLM_AUTH_USERNAME / SLM_AUTH_PASSWORD is set), every endpoint except /healthz needs an API key (`Authorization: Bearer slm_...`, made in My account), HTTP basic authentication or a session cookie. A key does at most what its user does, and a read-only key only looks and downloads. Read-only users can call the GET endpoints; changes need an administrator. Requests that change data are rejected when they come from another web site; requests without browser headers (curl, scripts, Home Assistant) are accepted.",
    "license": {
      "name": "MIT"
    },
    "version": "1.55.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {},
    {
      "bearerAuth": []
    },
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/api/titles": {
      "get": {
        "summary": "Games in the library",
        "description": "All base games of the library by title ID, with their latest local update and DLC.",
        "tags": [
          "Library"
        ],
        "responses": {
          "200": {
            "description": "Games by title ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/Title"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/titles/{titleId}": {
      "get": {
        "summary": "Download the base game file",
        "tags": [
          "Downloads"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/titleId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/File"
          },
          "404": {
            "description": "Not in the library"
          }
        }
      }
    },
    "/api/titles/{titleId}/override": {
      "get": {
        "summary": "What was changed of a game by hand",
        "description": "The name, cover and description an administrator gave the game on its page. They win over the titles database, its translations, the files of the game and IGDB, in every language. An update or DLC ID tells its game.",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/titleId"
          }
        ],
        "responses": {
          "200": {
            "description": "The changes; edited is false when there are none",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TitleOverride"
                }
              }
            }
          },
          "400": {
            "description": "Invalid title ID"
          },
          "404": {
            "description": "Neither the titles database nor the library knows the game"
          }
        }
      },
      "post": {
        "summary": "Change the name, cover or description of a game",
        "description": "Kept apart from the titles database, by title ID, so synchronizations and scans never lose it; the files of the game and its title ID are not touched, and Organize uses the name given when it runs. The name and the description sent replace the ones kept (empty: those of the game). A cover sent, as a file or as an address downloaded once, replaces the one kept; without one the cover kept stays. Covers must be JPEG, PNG or GIF images of at most 5 MB and 6000 pixels a side; they are made again, at most 1024 pixels a side. When nothing is left the change is forgotten.",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/titleId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "The name shown; empty for the one of the game"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 10000,
                    "description": "Empty for the one of the game"
                  },
                  "cover": {
                    "type": "string",
                    "format": "binary",
                    "description": "A new cover"
                  },
                  "coverUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "The address of a new cover on the internet, downloaded once"
                  },
                  "removeCover": {
                    "type": "boolean",
                    "default": false,
                    "description": "true shows the cover of the game again"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 10000
                  },
                  "coverUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "removeCover": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kept and shown (after the synchronization running, if any)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TitleOverride"
                }
              }
            }
          },
          "400": {
            "description": "Invalid title ID, or a cover that is not an image, too large or that could not be downloaded"
          },
          "404": {
            "description": "Neither the titles database nor the library knows the game"
          }
        }
      },
      "delete": {
        "summary": "Back to the original",
        "description": "Forgets what was changed of the game by hand, and deletes the cover chosen.",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/titleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Forgotten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TitleOverride"
                }
              }
            }
          },
          "400": {
            "description": "Invalid title ID"
          },
          "404": {
            "description": "Neither the titles database nor the library knows the game"
          }
        }
      }
    },
    "/api/titles/{titleId}/updates/{version}": {
      "get": {
        "summary": "Download an update file",
        "tags": [
          "Downloads"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/titleId"
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 65536
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/File"
          },
          "404": {
            "description": "Not in the library"
          }
        }
      }
    },
    "/api/titles/{titleId}/dlc/{dlcTitleId}": {
      "get": {
        "summary": "Download a DLC file",
        "tags": [
          "Downloads"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/titleId"
          },
          {
            "name": "dlcTitleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{16}$"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/File"
          },
          "404": {
            "description": "Not in the library"
          }
        }
      }
    },
    "/api/titles/{titleId}/archive.zip": {
      "get": {
        "summary": "Download all files of a game",
        "description": "The base game, its updates (Updates/) and DLC (DLC/) as an uncompressed ZIP archive.",
        "tags": [
          "Downloads"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/titleId"
          }
        ],
        "responses": {
          "200": {
            "description": "ZIP archive",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Not in the library"
          }
        }
      }
    },
    "/api/titles/{titleId}/cheats.txt": {
      "get": {
        "summary": "Download the cheats of a game",
        "description": "The cheats of the version the library has (the game or its latest update), as the text file Atmosphère reads, named after its build ID.",
        "tags": [
          "Downloads"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/titleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Cheats",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not in the library, or no cheats for its version"
          }
        }
      }
    },
    "/api/titles/{titleId}/cheats.zip": {
      "get": {
        "summary": "Download the cheats of a game for the SD card",
        "description": "The cheats of the version the library has, as atmosphere/contents/<title ID>/cheats/<build ID>.txt in a ZIP archive.",
        "tags": [
          "Downloads"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/titleId"
          }
        ],
        "responses": {
          "200": {
            "description": "ZIP archive",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Not in the library, or no cheats for its version"
          }
        }
      }
    },
    "/api/cheats.zip": {
      "get": {
        "summary": "Download the cheats of the library for the SD card",
        "description": "The cheats of every game of the library at the version it has, as atmosphere/contents/<title ID>/cheats/<build ID>.txt in a ZIP archive.",
        "tags": [
          "Downloads"
        ],
        "responses": {
          "200": {
            "description": "ZIP archive",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "No cheats for the games of the library"
          }
        }
      }
    },
    "/api/statistics": {
      "get": {
        "summary": "Library statistics",
        "description": "The numbers of the Statistics page, e.g. for a Home Assistant REST sensor.",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "description": "Language of the game names",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "es"
              ],
              "default": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          }
        }
      }
    },
    "/api/keys": {
      "get": {
        "summary": "Your API keys",
        "description": "The API keys of the user who asks, the newest first. The keys themselves are never sent again, only their last characters. An administrator gets the keys of every user with all=true.",
        "tags": [
          "Account"
        ],
        "parameters": [
          {
            "name": "all",
            "in": "query",
            "description": "The keys of every user (administrators only)",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The keys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/APIKey"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Make an API key",
        "description": "A key for the user who asks, signed in with a session or a password: a key cannot make keys. The key is in this answer only and cannot be shown again; only a hash of it is kept. It never does more than its user does at the time: when the role of the user is lowered, the key does less too, and the keys of a deleted user go with them. A user has at most 20 keys.",
        "tags": [
          "Account"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 40,
                    "description": "To tell the key from the others, e.g. where it is used",
                    "example": "Home Assistant"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "viewer",
                      "editor",
                      "admin"
                    ],
                    "default": "viewer",
                    "description": "viewer is read only: it looks and downloads. editor and admin only for a user with that role."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The key made, with the key itself",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIKeyCreated"
                }
              }
            }
          },
          "400": {
            "description": "A name that is empty or too long, a role the user does not have, 20 keys already, or a user without keys (the one of SLM_AUTH_USERNAME, or login off)"
          },
          "403": {
            "description": "Asked with an API key"
          }
        }
      }
    },
    "/api/keys/{id}": {
      "delete": {
        "summary": "Revoke an API key",
        "description": "The key stops signing in at once. A user revokes their own keys, an administrator anybody's; not with an API key.",
        "tags": [
          "Account"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the key, from GET /api/keys",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The key revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIKey"
                }
              }
            }
          },
          "403": {
            "description": "Asked with an API key"
          },
          "404": {
            "description": "No such key, or a key of another user"
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This API description",
        "tags": [
          "Service"
        ],
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/export/library-site.zip": {
      "get": {
        "summary": "Export the library as a web page",
        "tags": [
          "Library"
        ],
        "responses": {
          "200": {
            "description": "ZIP with an index.html that opens without the app and the thumbnails of the covers",
            "content": {
              "application/zip": {}
            }
          }
        }
      }
    },
    "/export/library.csv": {
      "get": {
        "summary": "Export the library as CSV",
        "tags": [
          "Library"
        ],
        "responses": {
          "200": {
            "description": "UTF-8 CSV with a byte order mark",
            "content": {
              "text/csv": {}
            }
          }
        }
      }
    },
    "/export/library.json": {
      "get": {
        "summary": "Export the library as JSON",
        "description": "Every game with its files and DLC, with the original game names.",
        "tags": [
          "Library"
        ],
        "responses": {
          "200": {
            "description": "Inventory",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/sync": {
      "get": {
        "summary": "Synchronization status",
        "tags": [
          "Synchronization"
        ],
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Start a synchronization",
        "description": "Downloads the titles database and rescans the library in the background. If a synchronization is already running, that one continues.",
        "tags": [
          "Synchronization"
        ],
        "responses": {
          "202": {
            "description": "Started or already running"
          }
        }
      }
    },
    "/ignore": {
      "post": {
        "summary": "Ignore or restore missing DLC or updates",
        "tags": [
          "Library"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "dlc",
                      "update"
                    ]
                  },
                  "id": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9A-Fa-f]{16}$"
                    },
                    "description": "One or several title IDs (repeat the field)"
                  },
                  "ignored": {
                    "type": "boolean",
                    "default": true,
                    "description": "false restores the IDs"
                  }
                }
              },
              "encoding": {
                "id": {
                  "explode": true
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied"
          },
          "400": {
            "description": "Invalid title ID or list"
          }
        }
      }
    },
    "/verify/start": {
      "post": {
        "summary": "Check the files",
        "description": "Checks the files of the library in the background, at a level: signature reads the header of every NCA and tells in seconds whether it has the signature of Nintendo; hash reads every file whole and checks every NCA against its hashes; both does the two, the hashes even when the signature fails. A file whose data does not match its hashes is failed; a file with an NCA not signed by Nintendo and nothing damaged is modified, which is no failure. The results are listed on the Issues page and in the task (GET /api/tasks). If a task works on the files, the check waits in the queue.",
        "tags": [
          "Library"
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "string",
                    "enum": [
                      "signature",
                      "hash",
                      "both"
                    ],
                    "default": "both"
                  },
                  "all": {
                    "type": "boolean",
                    "default": false,
                    "description": "true checks every file again; false only the new and changed ones"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nothing to check: no file is new or changed since its last check at this level",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nothing": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Started, or added to the queue"
          },
          "400": {
            "description": "Invalid level"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Health check",
        "description": "Answers ok without authentication.",
        "tags": [
          "Service"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "summary": "Running and recent tasks",
        "description": "Synchronizations, scans and organize runs, newest first. Failed tasks stay until they are dismissed.",
        "tags": [
          "Tasks"
        ],
        "responses": {
          "200": {
            "description": "The tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/events": {
      "get": {
        "summary": "Task changes as server-sent events",
        "description": "Sends an event `tasks` with the version of the task list right away and after every change (at most twice a second), and a comment every 20 seconds to keep the connection open.",
        "responses": {
          "200": {
            "description": "Event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "slm_ and 40 letters and digits",
        "description": "An API key, made in My account or with POST /api/keys. Wrong keys count as failed sign-ins and block the address after a few."
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "parameters": {
      "titleId": {
        "name": "titleId",
        "in": "path",
        "required": true,
        "description": "Title ID of the base game",
        "schema": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{16}$"
        },
        "example": "0100152000022000"
      }
    },
    "responses": {
      "File": {
        "description": "File download",
        "content": {
          "application/octet-stream": {
            "schema": {
              "type": "string",
              "format": "binary"
            }
          }
        }
      }
    },
    "schemas": {
      "File": {
        "type": "object",
        "properties": {
          "downloadUrl": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string",
            "example": "NSP"
          }
        }
      },
      "Title": {
        "allOf": [
          {
            "$ref": "#/components/schemas/File"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Names by language tag"
              },
              "region": {
                "type": "string"
              },
              "iconUrl": {
                "type": "string"
              },
              "bannerUrl": {
                "type": "string"
              },
              "thumbnailUrl": {
                "type": "string"
              },
              "requiredSystemVersion": {
                "type": "integer"
              },
              "latestUpdate": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer"
                  },
                  "displayVersion": {
                    "type": "string"
                  },
                  "downloadUrl": {
                    "type": "string"
                  }
                }
              },
              "dlc": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "version": {
                      "type": "integer"
                    },
                    "downloadUrl": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "TitleOverride": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Title ID of the game"
          },
          "edited": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "coverUrl": {
            "type": "string",
            "description": "The cover chosen, served by the app"
          },
          "changed": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Share": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Statistics": {
        "type": "object",
        "properties": {
          "games": {
            "type": "integer"
          },
          "updates": {
            "type": "integer"
          },
          "dlc": {
            "type": "integer"
          },
          "totalSize": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes"
          },
          "gamesUpToDate": {
            "type": "integer"
          },
          "gamesWithUpdate": {
            "type": "integer"
          },
          "missingDlc": {
            "type": "integer"
          },
          "gamesMissingDlc": {
            "type": "integer"
          },
          "missingGames": {
            "type": "integer"
          },
          "issues": {
            "type": "integer"
          },
          "byContent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Share"
            }
          },
          "byFormat": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Share"
            }
          },
          "largest": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          },
          "synchronizing": {
            "type": "boolean"
          },
          "lastSync": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SyncStatus": {
        "type": "object",
        "properties": {
          "synchronizing": {
            "type": "boolean"
          },
          "current": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "description": "0 when the number of steps is unknown"
          },
          "message": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "The message in the language of the request"
          }
        }
      },
      "TaskNote": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "English sentence, translated by the interface"
          },
          "detail": {
            "type": "string",
            "description": "Technical reason"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "enum": [
              "sync",
              "scan",
              "organize",
              "cleanup",
              "verify"
            ]
          },
          "trigger": {
            "type": "string",
            "enum": [
              "manual",
              "schedule",
              "watcher",
              "settings",
              "startup",
              "organize"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "success",
              "warning",
              "failed"
            ]
          },
          "started": {
            "type": "string",
            "format": "date-time"
          },
          "finished": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "integer",
            "description": "-1 when unknown"
          },
          "total": {
            "type": "integer",
            "description": "-1 when unknown"
          },
          "message": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "The message in the language of the request"
          },
          "error": {
            "$ref": "#/components/schemas/TaskNote"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskNote"
            }
          },
          "games": {
            "type": "integer"
          },
          "files": {
            "type": "integer"
          },
          "damaged": {
            "type": "integer",
            "description": "A check: the files failed, whose data does not match their hashes"
          },
          "modified": {
            "type": "integer",
            "description": "A check: the files modified, with an NCA not signed by Nintendo and nothing damaged (no failure)"
          },
          "level": {
            "type": "string",
            "enum": [
              "signature",
              "hash",
              "both"
            ],
            "description": "A check: what it checks; empty for the checks of versions before it"
          }
        }
      },
      "APIKey": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "description": "The user the key is of"
          },
          "id": {
            "type": "string",
            "example": "3f9c2a7d1e4b8a60"
          },
          "name": {
            "type": "string",
            "example": "Home Assistant"
          },
          "role": {
            "type": "string",
            "enum": [
              "guest",
              "viewer",
              "editor",
              "admin"
            ],
            "description": "What the key may do now: the lower of the role it was made with and the role of its user"
          },
          "madeAs": {
            "type": "string",
            "enum": [
              "viewer",
              "editor",
              "admin"
            ],
            "description": "The role it was made with, only when its user may do less now"
          },
          "hint": {
            "type": "string",
            "description": "The last characters of the key, to tell it from the others",
            "example": "slm_…k7Qa"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsed": {
            "type": "string",
            "format": "date-time",
            "description": "Noted at most every 10 minutes; missing if never used"
          }
        }
      },
      "APIKeyCreated": {
        "allOf": [
          {
            "$ref": "#/components/schemas/APIKey"
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "The key, to send as Authorization: Bearer. Shown this once."
              }
            }
          }
        ]
      }
    }
  }
}
