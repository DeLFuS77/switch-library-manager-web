{
    "id": "/",
    "name": "Switch Library Manager Web",
    "short_name": "Switch Library",
    "description": "Manage your Nintendo Switch game library: updates, DLC, compression and more.",
    "start_url": "/index.html",
    "scope": "/",
    "display": "standalone",
    "theme_color": "#0d1117",
    "background_color": "#0d1117",
    "categories": [
        "games",
        "utilities"
    ],
    "icons": [
        {
            "src": "/resources/static/android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/resources/static/android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/resources/static/maskable-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Missing updates",
            "url": "/updates.html",
            "icons": [
                {
                    "src": "/resources/static/android-chrome-192x192.png",
                    "sizes": "192x192"
                }
            ]
        },
        {
            "name": "Missing DLC",
            "url": "/dlc.html",
            "icons": [
                {
                    "src": "/resources/static/android-chrome-192x192.png",
                    "sizes": "192x192"
                }
            ]
        },
        {
            "name": "Tasks",
            "url": "/tasks.html",
            "icons": [
                {
                    "src": "/resources/static/android-chrome-192x192.png",
                    "sizes": "192x192"
                }
            ]
        }
    ]
}
